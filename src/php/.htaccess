# Syndicate Holdings Group — stusyn.com (Apache / LiteSpeed on cPanel)

# MultiViews makes Apache map /careers/... to careers.php before the rules below run, which breaks job pages.
Options -Indexes -MultiViews
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Always use https://stusyn.com (no www)
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://stusyn.com%{REQUEST_URI} [L,R=301,NE]
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://stusyn.com%{REQUEST_URI} [L,R=301,NE]

  # Careers hub: older /careers links redirect to the real pages
  RewriteRule ^careers/?$ /careers.php [L,R=301,QSA]
  RewriteRule ^careers/([a-z0-9-]+)/?$ /job.php?slug=$1 [L,R=301,QSA]
  RewriteRule ^careers\.html$ /careers.php [L,R=301]
  RewriteRule ^how-we-build\.html$ /ideas.html [L,R=301]
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
  # One-page website orders moved to the Syndicate Marketing store
  RewriteRule ^order\.php$ /one-page-website.html#order [L,R=301,NE]

  # Block private folders
  RewriteRule ^(app|storage)(/|$) - [F,L]
</IfModule>

# Never serve database, log or config files
<FilesMatch "\.(sqlite|sqlite-wal|sqlite-shm|log|ini|md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://crm.stusyn.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://crm.stusyn.com; form-action 'self' mailto:; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
  # Tells browsers to always use HTTPS for this domain.
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

AddType font/woff2 .woff2

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
